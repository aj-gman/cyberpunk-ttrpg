    background-image: linear-gradient(rgba(38, 242, 230, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(38, 242, 230, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    text-align: center;
    font-family: "Chakra Petch", sans-serif;
  }

  .glitch-home::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 40% at 30% 20%, rgba(255, 46, 109, 0.1), transparent 70%), radial-gradient(ellipse 60% 40% at 70% 80%, rgba(38, 242, 230, 0.1), transparent 70%);
