    line-height: 1;
    text-transform: uppercase;
    -webkit-font-smoothing: antialiased;
    animation: glitch-flicker 6s infinite;
  }

  .glitch-home-title::before,
  .glitch-home-title::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    background: var(--glitch-bg);
    clip-path: inset(0 0 0 0);
  }

  .glitch-home-title::before { color: var(--glitch-pink); mix-blend-mode: screen; animation: glitch-top 4.5s infinite steps(1); }
  .glitch-home-title::after { color: var(--glitch-cyan); mix-blend-mode: screen; animation: glitch-bottom 4.5s infinite steps(1); }

  .glitch-home-title span {
