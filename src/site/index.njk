    color: #a9adb8;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .glitch-home-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 2.5rem; }

  .glitch-home-action {
    position: relative;
    padding: 0.85rem 1.6rem;
    border: 1px solid var(--glitch-cyan);
    color: var(--glitch-cyan);
    font-family: "Rajdhani", sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    transition: color 0.2s, background 0.2s;
  }

  .glitch-home-action:hover, .glitch-home-action:focus-visible { background: var(--glitch-cyan); color: var(--glitch-bg); }
  .glitch-home-action.alt { border-color: var(--glitch-pink); color: var(--glitch-pink); }
  .glitch-home-action.alt:hover, .glitch-home-action.alt:focus-visible { background: var(--glitch-pink); color: var(--glitch-bg); }

  @keyframes glitch-top {
    0%, 92%, 100% { clip-path: inset(0 0 0 0); transform: translate(0, 0); }
    93% { clip-path: inset(10% 0 60% 0); transform: translate(3px, -2px); }
    94% { clip-path: inset(60% 0 5% 0); transform: translate(-4px, 1px); }
    95% { clip-path: inset(30% 0 40% 0); transform: translate(2px, 2px); }
    96% { clip-path: inset(0 0 0 0); transform: translate(0, 0); }
  }

  @keyframes glitch-bottom {
    0%, 91%, 100% { clip-path: inset(0 0 0 0); transform: translate(0, 0); }
    92% { clip-path: inset(45% 0 20% 0); transform: translate(-3px, 2px); }
    93% { clip-path: inset(5% 0 75% 0); transform: translate(4px, -1px); }
    94% { clip-path: inset(70% 0 5% 0); transform: translate(-2px, -2px); }
    95% { clip-path: inset(0 0 0 0); transform: translate(0, 0); }
  }

  @keyframes glitch-flicker {
    0%, 96%, 100% { text-shadow: 0 0 8px rgba(255, 46, 109, 0.35), 0 0 18px rgba(38, 242, 230, 0.2); }
    97% { text-shadow: none; }
    98% { text-shadow: 0 0 8px rgba(255, 46, 109, 0.35), 0 0 18px rgba(38, 242, 230, 0.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-home-title, .glitch-home-title::before, .glitch-home-title::after { animation: none; }
  }

  @media (max-width: 600px) {
    .glitch-home-kicker {
      max-width: 22rem;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
    }

    .glitch-home-subhead {
      font-size: 0.95rem;
    }

    .glitch-home-actions {
      width: min(100%, 20rem);
    }

    .glitch-home-action {
      width: 100%;
    }
  }
</style>

